{
  "name": "scamp-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate": "node scripts/build-changelog.mjs && node scripts/build-docs.mjs && prisma generate",
    "dev": "next dev",
    "predev": "npm run generate",
    "build": "next build",
    "prebuild": "npm run generate",
    "build:dither": "node scripts/build-dither-snapshots.mjs",
    "db:status": "node scripts/db.mjs migrate status",
    "db:deploy": "node scripts/db.mjs migrate deploy",
    "db:studio": "node scripts/db.mjs studio",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "prepreview": "npm run generate",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "predeploy": "npm run generate",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "preupload": "npm run generate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "@prisma/adapter-neon": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@tabler/icons-react": "^3.44.0",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.6.26",
    "gray-matter": "^4.0.3",
    "next": "^16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "ignore": "^7.0.6",
    "playwright": "^1.62.0",
    "prettier": "3.8.2",
    "prisma": "^7.9.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "typescript": "^5",
    "unified": "^11.0.5",
    "wrangler": "^4.120.1"
  }
}
