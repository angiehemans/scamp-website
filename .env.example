# Copy to `.env` and fill in. `.env` is gitignored; this file is committed.
#
# LOCAL DEVELOPMENT
# Prisma 7 ships a local Postgres server, so no Docker or cloud account is
# needed to run the app locally:
#
#   npx prisma dev -n scamp -d     # start it (detached)
#   npx prisma dev ls              # print the DATABASE_URL to paste below
#   npx prisma dev stop scamp      # stop it
#
# PRODUCTION
# DATABASE_URL points at Neon. Running on Cloudflare Workers additionally needs
# the @prisma/adapter-neon driver adapter — see plans/auth-setup-phase-1.md.

DATABASE_URL=""
# ^ keep this on the LOCAL database. The dev server and every checkpoint script
#   read it, and several of those delete users — pointing it at Neon would run
#   them against production.
#
# Production credentials go in `.env.production.local` (also gitignored), used
# only by `npm run db:* -- --prod`.

# Prisma needs a separate empty database to detect drift during `migrate dev`.
# The local `prisma dev` server exposes one on the port after the main one.
# Not needed in production (`migrate deploy` does not use a shadow database).
SHADOW_DATABASE_URL=""
# ^ keep this on the LOCAL database. The dev server and every checkpoint script
#   read it, and several of those delete users — pointing it at Neon would run
#   them against production.
#
# Production credentials go in `.env.production.local` (also gitignored), used
# only by `npm run db:* -- --prod`.

# Better Auth ----------------------------------------------------------------
# Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Server-side only. Never prefix this NEXT_PUBLIC_ — that would bundle it into
# the client JavaScript.
BETTER_AUTH_SECRET=""

# Must match the origin the browser actually uses. In production this is the
# deployed site's URL.
BETTER_AUTH_URL="http://localhost:3000"

# Cloudflare R2 (production only) ---------------------------------------------
# Without these, uploads fall back to routing through the Worker via the local
# /api/blobs/direct route — fine for development, not for production.
# Create an R2 API token for the bucket to get the key pair.
R2_ACCOUNT_ID=""
R2_BUCKET_NAME="scamp-project-blobs"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# Resend — transactional email (verification) ---------------------------------
# Optional locally: with no key, the verification link is printed to the dev
# server console instead of being emailed, so the flow stays testable offline.
# Required in production.
RESEND_API_KEY=""

# Any mailbox at a domain verified in Resend. Until one is verified, Resend only
# accepts onboarding@resend.dev and only delivers to your own account address.
# A personal address needs to receive mail too — see api-docs/deployment.md.
EMAIL_FROM="Angie from Scamp <angie@scamp.club>"

# Admin access ----------------------------------------------------------------
# Comma-separated emails allowed to view /admin. Unset means nobody, including
# locally — a missing value must never open the page up. The account must also
# be verified, so listing an address that has not signed up yet cannot be
# claimed by whoever registers it first.
# Deliberately an env var, not a database column: admin rights then cannot be
# granted by anything that writes to the database, only by a redeploy.
ADMIN_EMAILS=""
