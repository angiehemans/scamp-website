// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"

  // REQUIRED for Cloudflare Workers. Do not remove.
  //
  // Prisma 7 compiles queries with a WebAssembly query compiler. Without this,
  // the client loads that Wasm at runtime, which Workers forbid — every query
  // fails with:
  //
  //   CompileError: WebAssembly.Module(): Wasm code generation disallowed by
  //   embedder
  //
  // and the HTTP response is a bare 500 with nothing to explain it. Setting the
  // target to workerd emits query_compiler_fast_bg.wasm as a real file that the
  // bundler imports statically, which Workers do allow.
  //
  // Verified to work in Node as well, so local `next dev` and all four
  // checkpoint scripts still pass against one generated client.
  runtime  = "workerd"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  purchases     Purchase[]
  desktopAuth   DesktopAuthRequest[]
  accounts      Account[]
  projects      Project[]

  /// Nullable on purpose: accounts predating this field were never asked, and
  /// null records that honestly. Do not let the Better Auth CLI turn this back
  /// into a non-null column — it emits `role String` regardless of
  /// `required: false`, and a NOT NULL migration fails on existing rows.
  /// Nullable on purpose: accounts predating this field were never asked, and
  /// null records that honestly.
  role       String?

  /// Updated at most once every LAST_SEEN_THROTTLE_MS on authenticated
  /// requests — see lib/session.ts. Drives DAU/MAU on the admin page.
  lastSeenAt DateTime?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// --- Cloud backup -----------------------------------------------------
// See plans/cloud-backup.md. File *content* lives in R2 keyed by its own
// sha256; file *structure* lives here as a manifest. A version is therefore a
// row, not a copy of the project.

model Project {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions ProjectVersion[]
  blobs    Blob[]

  @@index([userId])
}

/// One push. `manifest` is the complete state of the project at that moment
/// ({ "app/page.tsx": "<sha256>", ... }), which is what makes unlimited version
/// history cost a row rather than a copy.

model ProjectVersion {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  manifest   Json
  fileCount  Int
  totalBytes BigInt
  /// Which machine pushed it. Needed for the "changes from another machine"
  /// banner once sync lands — see plans/cloud-sync.md.
  deviceId   String?
  createdAt  DateTime @default(now())

  @@index([projectId, createdAt])
}

/// Sizes of blobs known to exist in R2, so a user's storage total can be shown
/// without listing the bucket. Deliberately has no refCount: content is never
/// deleted when a file is removed (unlimited history), and blobs are scoped to
/// one project, so deleting a project is a prefix delete. There is no GC.

model Blob {
  projectId String
  hash      String
  size      Int
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, hash])
}

/// One shipped version of the desktop app. See plans/paid-downloads.md.
///
/// `publishedAt` is nullable rather than a `draft` boolean so a release can be
/// staged: upload all three installers, verify their hashes, and only then make
/// it live in a single write. A half-uploaded release is never reachable,
/// because every read filters on `publishedAt != null`.
///
/// Ordering is by `publishedAt`, never by `version` — "0.10.0" sorts before
/// "0.9.0" as a string, which would serve the wrong build.

model Release {
  id          String    @id @default(cuid())
  version     String    @unique
  notes       String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  assets ReleaseAsset[]

  @@index([publishedAt])
}

/// One platform's installer within a release.
///
/// `key` is the R2 object key and is never sent to a client: downloads go
/// through a presigned URL minted server-side, so the bucket layout stays
/// private and links expire.

model ReleaseAsset {
  id        String  @id @default(cuid())
  releaseId String
  release   Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  /// "macos" | "windows" | "linux" — validated in lib/platforms.ts.
  platform  String
  key       String
  /// What the browser should save it as, sent via Content-Disposition.
  filename  String
  sizeBytes Int
  /// Published so a download can be verified. Also what the publish script
  /// checks the uploaded bytes against.
  sha256    String

  @@unique([releaseId, platform])
}

/// What someone chose to pay for a download. Bookkeeping, NOT an entitlement.
///
/// Nothing reads this before serving a file — see plans/paid-downloads.md. Its
/// jobs are the revenue figures on /admin and deciding whether to show the
/// pay-what-you-want form again (one prompt per account, not per download).
///
/// `amountCents` is an integer, never a float: $19.99 in binary floating point
/// is a reconciliation that quietly fails to balance.
///
/// The `stripe*` columns are unused until Phase 2. They are here now because
/// they are nullable and belong to this table anyway, and adding them later
/// would be a second migration for no gain.
///
/// `status` is a String rather than an enum deliberately: `@better-auth/cli
/// generate` rewrites this file and drops enum declarations it does not know
/// about. lib/purchase-status.ts holds the validated values instead.

model Purchase {
  id                    String    @id @default(cuid())
  /// Null for a guest download from the marketing pages. Filled in later if
  /// that person creates an account with the same address — see the user
  /// create hook in lib/auth.ts.
  userId                String?
  user                  User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Always set for a guest row, and the only way back to that person. Kept on
  /// signed-in rows too, so a deleted account still leaves the revenue figure
  /// attributable.
  email                 String?
  /// True when this download was taken without an account.
  ///
  /// Explicit rather than inferred. Today a guest row is recognisable by
  /// `userId == null && email != null`, but that only holds by coincidence:
  /// once paid checkout lands, a signed-in purchase carries an email too, and
  /// linking a guest download to a new account fills in its userId. Both would
  /// quietly corrupt "how many people downloaded without an account", and the
  /// number would look fine while being wrong.
  wasGuest              Boolean   @default(false)

  /// sha256 of the client IP, for rate limiting the open guest endpoint.
  /// Hashed rather than stored raw: it only ever needs to be compared, and an
  /// address next to an email address is more than this needs to keep.
  ipHash                String?
  amountCents           Int
  currency              String    @default("usd")
  /// free | pending | paid | refunded
  status                String
  /// Which platform the download was for. Product signal only.
  platform              String?
  stripeSessionId       String?   @unique
  stripePaymentIntentId String?   @unique
  createdAt             DateTime  @default(now())
  paidAt                DateTime?

  @@index([userId])
  @@index([email])
  @@index([ipHash, createdAt])
  @@index([status, createdAt])
}

/// One in-flight desktop sign-in.
///
/// The desktop app opens the browser, the person signs in there, and the
/// resulting session has to get back to the app. The callback is a custom
/// scheme (`scamp://auth/callback`), and on every desktop OS *any* application
/// can register a scheme — so the callback URL must be assumed readable by
/// software that is not ours.
///
/// That is why the code in the callback is worthless on its own. The app picks
/// a random `verifier` before opening the browser and sends only its SHA-256
/// (`codeChallenge`); redeeming the code requires presenting the verifier. An
/// interceptor gets a code it cannot spend. This is PKCE, and it exists for
/// exactly this attack.
///
/// `state` is echoed back untouched so the app can reject a callback it did
/// not initiate.

model DesktopAuthRequest {
  /// The value handed to the app in the callback URL. Random, single use.
  code        String    @id
  /// Base64url SHA-256 of the app's verifier. Never the verifier itself.
  codeChallenge String
  /// Returned verbatim on the callback. Opaque to us.
  state       String
  /// Where the code is sent. Checked against the allowlist, never trusted raw.
  redirectUri String
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The Better Auth one-time token this code stands in for. Handed over only
  /// once the verifier checks out.
  oneTimeToken String
  expiresAt   DateTime
  /// Set on redemption. A second attempt with the same code is refused, so a
  /// stolen code is useless once the real app has used it — and if the thief
  /// gets there first, the real app fails loudly instead of both succeeding.
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([expiresAt])
}

/// Rate limiting state. Lives in the database rather than memory because
/// Workers isolates do not share memory — an in-memory counter resets
/// constantly and gives almost no brute-force protection.
///
/// Generated by `npx @better-auth/cli generate`. NOTE: that command OVERWRITES
/// this file and strips `runtime = "workerd"` from the generator block above.
/// Check it is still there after running it, or the next deploy dies with a
/// Wasm CompileError.

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}
